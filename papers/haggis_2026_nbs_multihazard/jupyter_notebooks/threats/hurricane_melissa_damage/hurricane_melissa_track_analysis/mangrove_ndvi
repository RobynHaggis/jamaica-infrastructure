// RGB bands
var rgbBands = ['B4','B3','B2'];

// Fixed vis stretch (HLS reflectance is typically scaled ~0–10000)
var rgbVis = {
  bands: rgbBands,
  min: 0,
  max: 8000,
  gamma: 1.2
};

// --- Masks (HLS Fmask is a BITMASK)
// bit 1 cloud, bit 2 adjacent, bit 3 shadow, bit 4 snow, bit 5 water
function maskCloudOnly(img) {
  var f = img.select('Fmask');
  var notCloud = f.bitwiseAnd(1 << 1).eq(0);
  // also remove fill/invalid values so they don’t draw as black
  var valid = img.select('B2').gt(0).and(img.select('B3').gt(0)).and(img.select('B4').gt(0));
  return img.updateMask(notCloud.and(valid));
}

function maskCloudShadow(img) {
  var f = img.select('Fmask');
  var notCloud  = f.bitwiseAnd(1 << 1).eq(0);
  var notShadow = f.bitwiseAnd(1 << 3).eq(0);
  var valid = img.select('B2').gt(0).and(img.select('B3').gt(0)).and(img.select('B4').gt(0));
  return img.updateMask(notCloud.and(notShadow).and(valid));
}

// --- Composites
