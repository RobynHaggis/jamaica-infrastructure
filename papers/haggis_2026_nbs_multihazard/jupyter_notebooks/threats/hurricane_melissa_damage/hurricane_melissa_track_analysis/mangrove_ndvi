print('Date window:', start, 'to', end);

var cloudThresh = 30;

// Select only bands common to both HLSL30 and HLSS30
var bandsToKeep = ['B2', 'B3', 'B4', 'Fmask'];

// Build merged HLS collection
var hlsL30 = ee.ImageCollection("NASA/HLS/HLSL30/v002")
  .filterBounds(geometry)
  .filterDate(start, end)
  .filter(ee.Filter.lt('CLOUD_COVERAGE', cloudThresh))
  .select(bandsToKeep);

var hlsS30 = ee.ImageCollection("NASA/HLS/HLSS30/v002")
  .filterBounds(geometry)
  .filterDate(start, end)
  .filter(ee.Filter.lt('CLOUD_COVERAGE', cloudThresh))
  .select(bandsToKeep);

var hls = hlsL30.merge(hlsS30).sort('system:time_start');

print('HLS images in date window:', hls.size());

// Self-defined mask function using Fmask
var maskHLSFmask = function(img) {
  var fmask = img.select('Fmask');

  var cloudBit  = fmask.bitwiseAnd(1 << 1).neq(0);
  var adjBit    = fmask.bitwiseAnd(1 << 2).neq(0);
  var shadowBit = fmask.bitwiseAnd(1 << 3).neq(0);
  var snowBit   = fmask.bitwiseAnd(1 << 4).neq(0);

  var clearMask = cloudBit.not()
    .and(adjBit.not())
    .and(shadowBit.not())
    .and(snowBit.not());

  return img.updateMask(clearMask);
};

// Apply mask function to all images
var maskedCollection = hls.map(maskHLSFmask);

