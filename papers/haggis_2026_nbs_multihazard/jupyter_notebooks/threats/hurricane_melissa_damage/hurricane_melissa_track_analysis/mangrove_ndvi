var median_unmasked = hls.select(rgbBands).median().clip(geometry);

var median_cloudOnly   = hls.map(maskCloudOnly).select(rgbBands).median().clip(geometry);
var median_cloudShadow = hls.map(maskCloudShadow).select(rgbBands).median().clip(geometry);

